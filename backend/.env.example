# Deal Hunter AI - Backend environment variables
# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
APP_DEBUG=true
APP_NAME="Deal Hunter AI"

# Postgres
DATABASE_URL=postgresql+asyncpg://dealhunter:dealhunter@localhost:5432/dealhunter
DATABASE_URL_SYNC=postgresql+psycopg2://dealhunter:dealhunter@localhost:5432/dealhunter

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-64-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# eBay official API (Band 7 - eBay.com/eBay.de provider)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=PRODUCTION

# eBay Kleinanzeigen provider
# NOTE: Kleinanzeigen has no official public API and its Terms of Service
# prohibit automated data collection. This provider is built to respect
# robots.txt and rate limits and does NOT bypass bot detection/CAPTCHAs.
# Get legal sign-off before enabling in production.
KLEINANZEIGEN_PROVIDER_ENABLED=false
KLEINANZEIGEN_REQUEST_DELAY_SECONDS=3

# Firebase Cloud Messaging (Band 11 - Notifications)
# Optional. Without both of these, notifications still work end-to-end
# (persisted, listed, mark-as-read, preferences) but push delivery is
# skipped — same "not_available" pattern as the other optional providers
# below. FCM_CREDENTIALS_JSON_PATH is the path to a Firebase service
# account JSON key file (Firebase Console -> Project Settings -> Service
# Accounts -> Generate new private key). Never commit that file.
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON_PATH=

# Resend (Band 11 - Notifications, EMAIL channel)
# Optional. Without both of these, EMAIL notifications are still recorded
# (persisted, listed) but delivery is skipped — same pattern as FCM above.
# Get an API key at https://resend.com (free tier available) and verify a
# sending domain/address there; RESEND_FROM_EMAIL must be an address on a
# domain you've verified with Resend, not an arbitrary address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Claude Vision API (Band 08 - cosmetic-condition detection)
# Optional. Without this, /vision-observation still works but
# cosmetic_condition stays "not_available" (image-quality checks only).
ANTHROPIC_API_KEY=
# claude-opus-5 is the default per Anthropic's own guidance (never downgrade
# for cost without an explicit decision) — override to e.g. claude-haiku-4-5
# if you want cheaper/faster triage at lower accuracy for high-volume use.
ANTHROPIC_VISION_MODEL=claude-opus-5

# Marketplace ingestion scheduler (Band 13 - Deployment/DevOps)
# Off by default. Enable in exactly one running instance per environment —
# this is an in-process asyncio loop (app/modules/offers/infrastructure/
# scheduler.py), not a distributed job queue, so enabling it on multiple
# replicas would fetch/ingest the same listings redundantly (harmless
# thanks to upsert-by-source-id, just wasteful and multiplies API quota
# usage). See docs/deployment.md.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=900

# Rate limiting (Band 14 - Security-Härtung)
# Off by default — see app/core/rate_limit.py's module docstring for why
# (the existing integration test suite would trip a default-on limiter).
# Applies to POST /auth/login, /auth/register, /auth/refresh only.
RATE_LIMIT_ENABLED=false
